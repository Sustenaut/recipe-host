{
  "uses": [
    {
      "plugin": "cloudflare.dns",
      "paths": [
        "action.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        "action.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.edit-pr",
      "paths": [
        "action.yml",
        "app/app.js"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        "action.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "jsdelivr.purge",
      "paths": [
        "action.yml",
        "app/app.js",
        "app/index.html",
        "lib/page.js"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    }
  ],
  "own_hosts": [
    "schryer.eu",
    "sustenaut.eu"
  ],
  "exclude": [
    {
      "path": "test/**",
      "reason": "Fakes and test data"
    },
    {
      "path": "**/*.test.js",
      "reason": "Fakes and test data"
    }
  ]
}
