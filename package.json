{
  "name": "recipe-host",
  "version": "0.2.2",
  "description": "Host recipes from a GitHub repository: a static site served through jsDelivr, with a master ingredient list and changes made as pull requests.",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "c8 --reporter=lcov --reporter=text-summary --reports-dir=coverage --include='lib/**' --include='bin/**' cucumber-js",
    "test:browser": "cucumber-js --profile browser"
  },
  "license": "MIT",
  "dependencies": {
    "marked": "^18.1.0",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "recipe-host": "bin/recipe-host.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sustenaut/recipe-host.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@alpinejs/anchor": "^3.17.4",
    "@cucumber/cucumber": "13.3.0",
    "@sustenaut/theme": "github:Sustenaut/theme#v0.1.0",
    "alpinejs": "^3.17.4",
    "c8": "12.0.0",
    "oidc-client-ts": "^3.5.0",
    "playwright": "^1.64.1",
    "purecss": "^3.1.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
