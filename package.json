{
  "name": "recipe-host",
  "version": "0.2.0",
  "description": "Host recipes from a GitHub repository: a static site served through jsDelivr, with a master ingredient list and changes made as pull requests.",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "test:browser": "node --test --test-concurrency=1 test/*.browser.js"
  },
  "license": "MIT",
  "dependencies": {
    "marked": "^18.1.0",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "recipe-host": "bin/recipe-host.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schryer/recipe-host.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@alpinejs/anchor": "^3.17.4",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "alpinejs": "^3.17.4",
    "oidc-client-ts": "^3.5.0",
    "playwright": "^1.64.1",
    "purecss": "^3.1.0"
  }
}
